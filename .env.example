# AI Research Assistant - Environment Configuration
# Copy to .env and edit values as needed.
# This file documents all important configuration values for the project.

# ============================================================
# Ollama Configuration
# ============================================================
# Ollama server URL (local by default)
OLLAMA_HOST=http://localhost:11434

# LLM model for answer generation
# Default: small, fast model suitable for CPU
OLLAMA_LLM_MODEL=qwen2.5-coder:3b
# Available alternatives (choose one):
#   - qwen2.5-coder:3b    (default, good for code/tech, CPU-friendly)
#   - llama3.2:3b         (strong general-purpose)
#   - phi3:3.8b           (fast, good quality)
#   - gemma2:2b           (efficient, good performance)
#   - mistral:7b          (higher quality, more RAM)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
# Alternative embedding models:
#   - all-minilm:33m      (faster, smaller, lower dim)
#   - mxbai-embed-large:335m (higher quality, slower, larger dim)

# ============================================================
# Embedding Configuration (CPU-safe defaults)
# ============================================================
# Batch size for embedding requests (4 = small batches for CPU)
# Increase for faster throughput if your hardware supports it
EMBED_BATCH_SIZE=4
# Request timeout in seconds (Ollama embedding can be slow on CPU)
EMBED_TIMEOUT_SECONDS=300
# Maximum retry attempts for failed embedding requests
EMBED_MAX_RETRIES=2
# Whether to embed parent chunks (default: false - only child/abstract are embedded)
# Parent chunks are stored with metadata for later context expansion via parent_id
EMBED_PARENTS=false

# ============================================================
# Qdrant Configuration
# ============================================================
# Qdrant server host
QDRANT_HOST=localhost

# Qdrant server port
QDRANT_PORT=6333

# Qdrant collection name (stores paper vectors and metadata)
QDRANT_COLLECTION=ai_papers

# ============================================================
# Chunking Configuration
# ============================================================
# Target chunk size in tokens (for child chunks)
CHUNK_SIZE=512
# Overlap between child chunks (tokens)
CHUNK_OVERLAP=50
# Minimum chunk size allowed (tokens)
MIN_CHUNK_SIZE=100

# Parent chunk size (for RAPTOR hierarchy) - typically larger than child chunk size
PARENT_CHUNK_SIZE=1024
PARENT_CHUNK_OVERLAP=100

# ============================================================
# Retrieval Configuration
# ============================================================
# Number of dense vector results to retrieve from Qdrant
TOP_K_DENSE=10
# Number of BM25 keyword results to retrieve
TOP_K_BM25=10
# Number of final results after fusion/reranking
TOP_K_FINAL=5
# Rerank top-K before fusion (how many to consider before selecting final)
RERANK_TOP_K=20
# Enable hybrid retrieval (dense + BM25 with RRF fusion)
HYBRID_ENABLED=true

# ============================================================
# Adaptive Router Configuration
# ============================================================
# Confidence threshold for router to choose "no_retrieval" strategy
ROUTER_CONFIDENCE_THRESHOLD=0.7
# Whether to allow multi-step strategy for complex queries
ENABLE_MULTI_STEP=true
# Whether to allow RAPTOR strategy
ENABLE_RAPTOR=true
# Whether to allow experimental routing (bypasses reliable mode defaults)
EXPERIMENTAL_ROUTING=false

# ============================================================
# GraphRAG Configuration (Phase 4)
# ============================================================
# Enable GraphRAG retrieval strategy
GRAPH_ENABLED=true

# ============================================================
# GraphRAG Configuration (Phase 4)
# ============================================================
# Enable GraphRAG retrieval strategy
GRAPH_ENABLED=true
# Directory for graph persistence
GRAPH_DIR=data/graph
# Neighborhood expansion hops (1 or 2)
GRAPH_HOPS=1
# Max entities extracted per text chunk
GRAPH_MAX_ENTITIES_PER_TEXT=8
# Max relations extracted per text chunk
GRAPH_MAX_RELATIONS_PER_TEXT=8
# Number of supporting vector chunks to fetch alongside graph evidence
GRAPH_SUPPORTING_CHUNKS=3
# Build source priority: abstract_first, abstract_only, all_chunks
GRAPH_BUILD_SOURCE=abstract_first

# ============================================================
# Corrective RAG (CRAG) Configuration
# ============================================================
# Maximum number of correction iterations in CRAG
CRAG_MAX_ITERATIONS=3
# Relevance threshold for document grader
GRADER_RELEVANCE_THRESHOLD=0.5
# Reliable mode: when ON, forces single_shot/CRAG-light for normal questions
RELIABLE_MODE=true

# ============================================================
# Generation Configuration
# ============================================================

# ============================================================
# Generation Configuration
# ============================================================
# Temperature for LLM generation (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.1
# Maximum tokens in generated answer
MAX_TOKENS=2048

# ============================================================
# Paths Configuration
# ============================================================
# Directory containing raw PDF papers
PAPERS_DIR=data/papers

# Directory for processed/chunked data (JSON)
PROCESSED_DIR=data/processed

# BM25 keyword index directory
BM25_INDEX_DIR=data/processed/bm25

# Semantic cache file path
CACHE_PATH=data/cache/semantic_cache.json

# Qdrant storage directory (relative to project root)
QDRANT_STORAGE_DIR=qdrant_storage

# ============================================================
# Evaluation Configuration
# ============================================================
# Default questions file path
EVAL_QUESTIONS_PATH=data/eval/questions.jsonl

# Default output path for evaluation reports
EVAL_REPORT_PATH=data/eval/reports/evaluation_report.json

# Cache similarity threshold (0.0 to 1.0)
CACHE_SIMILARITY_THRESHOLD=0.92

# Cache maximum entries
CACHE_MAX_ENTRIES=1000