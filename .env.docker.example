# AI Research Assistant - Docker Environment Configuration
# Copy to .env for Docker Compose usage:
#   cp .env.docker.example .env
# Then: docker compose up -d

# ============================================================
# Container Hostnames (match docker-compose.yml service names)
# ============================================================
# Qdrant vector database URL (internal Docker network)
QDRANT_URL=http://qdrant:6333
# Ollama LLM/Embedding server URL (internal Docker network)
OLLAMA_HOST=http://ollama:11434

# ============================================================
# Model Configuration (match repo defaults from .env.example)
# ============================================================
OLLAMA_LLM_MODEL=qwen2.5-coder:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5

# ============================================================
# Retrieval & Runtime Mode (Reliable defaults)
# ============================================================
RELIABLE_MODE=true
EXPERIMENTAL_ROUTING=false
CPU_SAFE_MODE=true
HYBRID_ENABLED=true
RERANK_ENABLED=false

# ============================================================
# Retrieval Parameters
# ============================================================
TOP_K_DENSE=10
TOP_K_BM25=10
TOP_K_FINAL=5
RERANK_TOP_K=20
RRF_K=60

# ============================================================
# Embedding Configuration
# ============================================================
EMBED_BATCH_SIZE=4
EMBED_TIMEOUT_SECONDS=300
EMBED_MAX_RETRIES=2
EMBED_PARENTS=false
EMBED_QUERY_CACHE_MAX_SIZE=256

# ============================================================
# Generation Parameters
# ============================================================
TEMPERATURE=0.1
MAX_TOKENS=2048

# ============================================================
# Cache Configuration
# ============================================================
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_DUPLICATE_THRESHOLD=0.98
CACHE_MAX_ENTRIES=1000
CACHE_TTL_SECONDS=0

# ============================================================
# Sludge Filter Thresholds
# ============================================================
SLUDGE_MIN_LETTER_RATIO=0.30
SLUDGE_MAX_DIGIT_RATIO=0.50
SLUDGE_MAX_PUNCT_RATIO=0.40
SLUDGE_MIN_WORDS=5
SLUDGE_MIN_ALPHA_WORDS=2
SLUDGE_MAX_GLUED_RATIO=0.05

# ============================================================
# Multi-Step & RAPTOR Configuration
# ============================================================
MULTI_STEP_MAX_SUB_QUESTIONS=3
MULTI_STEP_MAX_FOLLOW_UP=1
RAPTOR_K_SUMMARY=5
RAPTOR_K_DETAIL_PER_SUMMARY=3
RAPTOR_MAX_DETAIL_CHUNKS_TOTAL=10
RAPTOR_BUILDER_MAX_TOKENS=256
RAPTOR_BUILDER_BATCH_SIZE=16
RAPTOR_BUILDER_MAX_CHUNKS_PER_GROUP=20

# ============================================================
# GraphRAG Configuration
# ============================================================
GRAPH_ENABLED=true
GRAPH_DIR=data/graph
GRAPH_HOPS=1
GRAPH_MAX_ENTITIES_PER_TEXT=8
GRAPH_MAX_RELATIONS_PER_TEXT=8
GRAPH_SUPPORTING_CHUNKS=3
GRAPH_BUILD_SOURCE=abstract_first
GRAPH_ENTITY_EXTRACT_MAX_CHARS=900
GRAPH_ENTITY_EXTRACT_FALLBACK_CHARS=600

# ============================================================
# Host Port Mapping (for host access to services)
# ============================================================
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
OLLAMA_PORT=11434

# ============================================================
# Healthcheck Timeout (seconds)
# ============================================================
HEALTHCHECK_TIMEOUT=5